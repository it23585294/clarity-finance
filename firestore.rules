rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Savings is a separate, owner-scoped allocation ledger. Existing financial policies below are unchanged.
    function gOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function gId(id) { return id is string && id.matches('^[A-Za-z0-9_-]{1,128}$'); }
    function gCalendar(date) {
      let y = int(date[0:4]); let m = int(date[5:7]); let d = int(date[8:10]);
      let leap = y % 400 == 0 || (y % 4 == 0 && y % 100 != 0);
      let last = m == 2 ? (leap ? 29 : 28) : (m in [4,6,9,11] ? 30 : 31);
      return y >= 1 && m >= 1 && m <= 12 && d >= 1 && d <= last;
    }
    function gDate(date) {
      return date is string && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && gCalendar(date);
    }
    function gDay(date) { return int(date[0:4]) * 10000 + int(date[5:7]) * 100 + int(date[8:10]); }
    function gToday() {
      let now = request.time + duration.value(330, 'm');
      return now.year() * 10000 + now.month() * 100 + now.day();
    }
    function gGoal(data) {
      let fields = ['name','targetMinor','openingMinor','startDate','deadline','savedMinor','version','lastOperationId','lastEntryId','createdAt','updatedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100 && data.name.matches('.*[^ \\t\\r\\n].*')
        && data.targetMinor is int && data.targetMinor > 0 && data.openingMinor is int && data.openingMinor >= 0
        && data.savedMinor is int && data.savedMinor >= 0 && data.version is int && data.version >= 0
        && gDate(data.startDate) && gDay(data.startDate) <= gToday()
        && gDate(data.deadline) && data.deadline > data.startDate
        && gId(data.lastOperationId) && data.lastEntryId is string && (data.lastEntryId == '' || gId(data.lastEntryId))
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    function gGoalValues(data) {
      return {'name':data.name,'targetMinor':data.targetMinor,'openingMinor':data.openingMinor,'startDate':data.startDate,'deadline':data.deadline};
    }
    function gEntryValues(data) {
      return {'kind':data.kind,'amountMinor':data.amountMinor,'entryDate':data.entryDate,'note':data.note,'deleted':data.deleted};
    }
    function gEntry(data) {
      let fields = ['kind','amountMinor','entryDate','note','deleted','version','lastOperationId','createdAt','updatedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.kind in ['contribution','withdrawal'] && data.amountMinor is int && data.amountMinor > 0
        && gDate(data.entryDate) && gDay(data.entryDate) <= gToday()
        && data.note is string && data.note.size() <= 500 && data.deleted is bool
        && data.version is int && data.version > 0 && gId(data.lastOperationId)
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    function gReceipt(uid, op) {
      return getAfter(/databases/$(database)/documents/users/$(uid)/savingsGoals/active/operations/$(op)).data;
    }
    function gNewReceipt(uid, data) {
      let op = gReceipt(uid, data.lastOperationId);
      return !exists(/databases/$(database)/documents/users/$(uid)/savingsGoals/active/operations/$(data.lastOperationId))
        && !existsAfter(/databases/$(database)/documents/users/$(uid)/savingsGoals/active/rejections/$(data.lastOperationId))
        && op.version == data.version && op.entryId == data.lastEntryId;
    }
    function gEffect(entry) { return entry.deleted ? 0 : (entry.kind == 'contribution' ? entry.amountMinor : -entry.amountMinor); }
    function gOldEffect(uid, id) {
      let path = /databases/$(database)/documents/users/$(uid)/savingsGoals/active/entries/$(id);
      return exists(path) ? gEffect(get(path).data) : 0;
    }
    function gDelta(before, after, oldValue, newValue) {
      // Both balances are nonnegative: their difference is representable. Guard opposite-sign entry deltas too.
      return (oldValue >= 0 || newValue <= 0 || newValue <= 9223372036854775807 + oldValue)
        && (oldValue <= 0 || newValue >= 0 || oldValue <= 9223372036854775807 + newValue)
        && after.savedMinor - before.savedMinor == newValue - oldValue;
    }
    function gLedgerChange(uid, before, after) {
      let entry = getAfter(/databases/$(database)/documents/users/$(uid)/savingsGoals/active/entries/$(after.lastEntryId)).data;
      let op = gReceipt(uid, after.lastOperationId);
      let existsBefore = exists(/databases/$(database)/documents/users/$(uid)/savingsGoals/active/entries/$(after.lastEntryId));
      return gId(after.lastEntryId)
        && after.diff(before).affectedKeys().hasOnly(['savedMinor','version','lastOperationId','lastEntryId','updatedAt'])
        && entry.lastOperationId == after.lastOperationId && entry.version == after.version && entry.updatedAt == request.time
        && op.payload == gEntryValues(entry)
        && ((op.kind == 'ENTRY_CREATE' && !existsBefore && !entry.deleted)
          || (op.kind == 'ENTRY_UPDATE' && existsBefore && !entry.deleted)
          || (op.kind == 'ENTRY_DELETE' && existsBefore && entry.deleted))
        && gDelta(before, after, gOldEffect(uid, after.lastEntryId), gEffect(entry));
    }
    function gEntryParent(uid, id, data) {
      let before = get(/databases/$(database)/documents/users/$(uid)/savingsGoals/active).data;
      let after = getAfter(/databases/$(database)/documents/users/$(uid)/savingsGoals/active).data;
      return exists(/databases/$(database)/documents/users/$(uid)/savingsGoals/active)
        && after.version > before.version && after.version == before.version + 1
        && after.lastEntryId == id && after.lastOperationId == data.lastOperationId && after.version == data.version
        && gNewReceipt(uid, after);
    }
    match /users/{uid}/savingsGoals/{goalId} {
      allow read: if gOwner(uid) && goalId == 'active';
      allow create: if gOwner(uid) && goalId == 'active' && gGoal(request.resource.data)
        && request.resource.data.version == 0 && request.resource.data.savedMinor == request.resource.data.openingMinor
        && request.resource.data.lastEntryId == '' && request.resource.data.createdAt == request.time
        && gDay(request.resource.data.deadline) > gToday() && gNewReceipt(uid, request.resource.data)
        && gReceipt(uid, request.resource.data.lastOperationId).kind == 'CREATE'
        && gReceipt(uid, request.resource.data.lastOperationId).payload == gGoalValues(request.resource.data);
      allow update: if gOwner(uid) && goalId == 'active' && gGoal(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.startDate == resource.data.startDate
        && request.resource.data.version > resource.data.version && request.resource.data.version == resource.data.version + 1
        && gNewReceipt(uid, request.resource.data)
        && ((gReceipt(uid, request.resource.data.lastOperationId).kind == 'EDIT' && request.resource.data.lastEntryId == ''
            && gReceipt(uid, request.resource.data.lastOperationId).payload == gGoalValues(request.resource.data)
            && request.resource.data.savedMinor - resource.data.savedMinor == request.resource.data.openingMinor - resource.data.openingMinor
            && (request.resource.data.deadline == resource.data.deadline || gDay(request.resource.data.deadline) > gToday()))
          || gLedgerChange(uid, resource.data, request.resource.data));
      allow delete: if false;
    }
    match /users/{uid}/savingsGoals/active/entries/{entryId} {
      allow read: if gOwner(uid);
      allow create: if gOwner(uid) && gId(entryId) && gEntry(request.resource.data) && !request.resource.data.deleted
        && request.resource.data.createdAt == request.time && gEntryParent(uid, entryId, request.resource.data)
        && gReceipt(uid, request.resource.data.lastOperationId).kind == 'ENTRY_CREATE';
      allow update: if gOwner(uid) && gEntry(request.resource.data) && !resource.data.deleted
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastOperationId != resource.data.lastOperationId && gEntryParent(uid, entryId, request.resource.data)
        && ((!request.resource.data.deleted && gReceipt(uid, request.resource.data.lastOperationId).kind == 'ENTRY_UPDATE')
          || (request.resource.data.deleted && gReceipt(uid, request.resource.data.lastOperationId).kind == 'ENTRY_DELETE'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted','version','lastOperationId','updatedAt'])));
      allow delete: if false;
    }
    match /users/{uid}/savingsGoals/active/operations/{operationId} {
      allow read: if gOwner(uid);
      allow create: if gOwner(uid) && gId(operationId)
        && !existsAfter(/databases/$(database)/documents/users/$(uid)/savingsGoals/active/rejections/$(operationId))
        && request.resource.data.keys().hasAll(['kind','entryId','version','payload','createdAt'])
        && request.resource.data.keys().hasOnly(['kind','entryId','version','payload','createdAt'])
        && request.resource.data.kind in ['CREATE','EDIT','ENTRY_CREATE','ENTRY_UPDATE','ENTRY_DELETE']
        && request.resource.data.version is int && request.resource.data.version >= 0 && request.resource.data.payload is map
        && request.resource.data.entryId is string && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(uid)/savingsGoals/active).data.lastOperationId == operationId
        && getAfter(/databases/$(database)/documents/users/$(uid)/savingsGoals/active).data.version == request.resource.data.version
        && ((request.resource.data.kind in ['CREATE','EDIT'] && request.resource.data.entryId == ''
            && request.resource.data.payload == gGoalValues(getAfter(/databases/$(database)/documents/users/$(uid)/savingsGoals/active).data))
          || (request.resource.data.kind in ['ENTRY_CREATE','ENTRY_UPDATE','ENTRY_DELETE'] && gId(request.resource.data.entryId)
            && request.resource.data.payload == gEntryValues(getAfter(/databases/$(database)/documents/users/$(uid)/savingsGoals/active/entries/$(request.resource.data.entryId)).data)));
      allow update, delete: if false;
    }

    // Expiry fences never alter savings. Their acknowledgement safely permits deadline-only replacement.
    match /users/{uid}/savingsGoals/active/rejections/{operationId} {
      function expiredPayload(data) {
        let p = data.payload;
        return p is map && p.keys().hasAll(['name','targetMinor','openingMinor','startDate','deadline'])
          && p.keys().hasOnly(['name','targetMinor','openingMinor','startDate','deadline'])
          && p.name is string && p.name.size() > 0 && p.name.size() <= 100 && p.name.matches('.*[^ \\t\\r\\n].*')
          && p.targetMinor is int && p.targetMinor > 0 && p.openingMinor is int && p.openingMinor >= 0
          && gDate(p.startDate) && gDay(p.startDate) <= gToday()
          && gDate(p.deadline) && p.deadline > p.startDate && gDay(p.deadline) <= gToday();
      }
      function unchangedParent(data) {
        let path = /databases/$(database)/documents/users/$(uid)/savingsGoals/active;
        return data.kind == 'CREATE' ? (data.version == 0 && !exists(path) && !existsAfter(path))
          : (data.version > 0 && exists(path) && get(path).data.version == data.version - 1
            && get(path).data.deadline != data.payload.deadline && getAfter(path).data == get(path).data);
      }
      allow read: if gOwner(uid);
      allow create: if gOwner(uid) && gId(operationId)
        && request.resource.data.keys().hasAll(['kind','version','payload','createdAt'])
        && request.resource.data.keys().hasOnly(['kind','version','payload','createdAt'])
        && request.resource.data.kind in ['CREATE','EDIT'] && request.resource.data.version is int
        && request.resource.data.createdAt == request.time && expiredPayload(request.resource.data)
        && unchangedParent(request.resource.data)
        && !existsAfter(/databases/$(database)/documents/users/$(uid)/savingsGoals/active/operations/$(operationId));
      allow update, delete: if false;
    }

    // Stable owner catalogues. Defaults are virtual until renamed/archived; financial references retain IDs.
    function cId(kind, id) {
      return id is string && (id.matches('^custom_[A-Za-z0-9_-]{1,100}$')
        || (kind == 'category' ? id in ['food_dining','transport','housing','utilities','shopping','health','entertainment','education','other']
          : id in ['salary','freelance','adsense']));
    }
    function cPath(uid, kind, id) {
      return kind == 'category' ? /databases/$(database)/documents/users/$(uid)/expenseCategories/$(id)
        : /databases/$(database)/documents/users/$(uid)/incomeSources/$(id);
    }
    function cActive(uid, kind, id) {
      let path = cPath(uid, kind, id);
      return cId(kind, id) && (existsAfter(path) ? getAfter(path).data.archived == false : !id.matches('^custom_.*$'));
    }
    function cValid(kind, d) {
      return d.keys().hasAll(['name','archived','defaultValue','createdAt','updatedAt'])
        && d.keys().hasOnly(['name','archived','defaultValue','createdAt','updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100 && d.name.matches('.*[^ \\t\\r\\n].*')
        && d.archived is bool && (kind == 'category' ? d.defaultValue in ['committed','discretionary'] : d.defaultValue in ['LKR','USD'])
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /users/{uid}/expenseCategories/{id} {
      allow read: if gOwner(uid);
      allow create: if gOwner(uid) && cId('category', id) && cValid('category', request.resource.data)
        && request.resource.data.createdAt == request.time && fGuard(uid, 'CATEGORY', '', id);
      allow update: if gOwner(uid) && cValid('category', request.resource.data) && request.resource.data.createdAt == resource.data.createdAt
        && (!resource.data.archived || request.resource.data.archived) && fGuard(uid, 'CATEGORY', '', id);
      allow delete: if false;
    }
    match /users/{uid}/incomeSources/{id} {
      allow read: if gOwner(uid);
      allow create: if gOwner(uid) && cId('source', id) && cValid('source', request.resource.data)
        && request.resource.data.createdAt == request.time && fGuard(uid, 'SOURCE', '', id);
      allow update: if gOwner(uid) && cValid('source', request.resource.data) && request.resource.data.createdAt == resource.data.createdAt
        && (!resource.data.archived || request.resource.data.archived) && fGuard(uid, 'SOURCE', '', id);
      allow delete: if false;
    }

    // Durable mutation protocol. No fields are added to legacy financial schemas.
    // Receipts and per-record pointers prove both directions of one atomic mutation.
    function fTarget(uid, d) {
      return d.group == 'EXPENSE' ? /databases/$(database)/documents/users/$(uid)/expenses/$(d.targetId)
        : d.group in ['INCOME','RECEIPT'] ? /databases/$(database)/documents/users/$(uid)/incomeReceipts/$(d.targetId)
        : d.group == 'PROJECT' ? /databases/$(database)/documents/users/$(uid)/expectedPayments/$(d.targetId)
        : d.group == 'MILESTONE' ? /databases/$(database)/documents/users/$(uid)/expectedPayments/$(d.parentId)/milestones/$(d.targetId)
        : d.group == 'CRYPTO' ? /databases/$(database)/documents/users/$(uid)/cryptoResults/$(d.targetId)
        : cPath(uid, d.group == 'CATEGORY' ? 'category' : 'source', d.targetId);
    }
    function fState(uid, group, parent, id) {
      let g = group == 'RECEIPT' ? 'INCOME' : group;
      return g == 'MILESTONE' ? /databases/$(database)/documents/users/$(uid)/syncStates/$(g)/parents/$(parent)/records/$(id)
        : /databases/$(database)/documents/users/$(uid)/syncStates/$(g)/records/$(id);
    }
    function fProof(d) {
      return d.keys().hasAll(['group','kind','targetId','parentId','expectedUpdatedAt','payload','createdAt'])
        && d.keys().hasOnly(['group','kind','targetId','parentId','expectedUpdatedAt','payload','createdAt'])
        && d.group in ['EXPENSE','INCOME','RECEIPT','PROJECT','MILESTONE','CRYPTO','CATEGORY','SOURCE']
        && gId(d.targetId) && d.parentId is string
        && (d.group in ['MILESTONE','RECEIPT'] ? gId(d.parentId) : d.parentId == '')
        && d.kind in ['CREATE','UPDATE','DELETE','CANCEL','ARCHIVE']
        && (d.kind == 'CREATE' ? d.expectedUpdatedAt == null : d.expectedUpdatedAt is timestamp)
        && (d.kind != 'DELETE' || d.group in ['EXPENSE','INCOME','CRYPTO'])
        && (d.kind != 'CANCEL' || d.group in ['PROJECT','MILESTONE'])
        && (d.kind != 'ARCHIVE' || d.group in ['CATEGORY','SOURCE'])
        && (d.group != 'RECEIPT' || d.kind == 'CREATE')
        && d.payload is map && d.createdAt == request.time;
    }
    function fIncomeValues(d) {
      return {'sourceId':d.sourceId,'receiptDate':d.receiptDate,'currency':d.currency,'originalAmountStr':d.originalAmountStr,
        'lkrAmountMinor':d.lkrAmountMinor,'conversionBasis':d.conversionBasis,'conversionRateStr':d.get('conversionRateStr',null),'note':d.note};
    }
    function fValues(group, d) {
      return group == 'EXPENSE' ? {'amountMinor':d.amountMinor,'currency':d.currency,'categoryId':d.categoryId,'paymentChannelId':d.paymentChannelId,
          'spendingType':d.spendingType,'expenseDate':d.expenseDate,'note':d.get('note','')}
        : group == 'INCOME' ? fIncomeValues(d)
        : group == 'RECEIPT' ? {'sourceId':d.sourceId,'receiptDate':d.receiptDate,'currency':d.currency,'originalAmountStr':d.originalAmountStr,
          'lkrAmountMinor':d.lkrAmountMinor,'conversionBasis':d.conversionBasis,'conversionRateStr':d.get('conversionRateStr',null),'note':d.note,
          'originalAmountMinor':d.originalAmountMinor,'linkedPaymentId':d.linkedPaymentId,'linkedMilestoneId':d.get('linkedMilestoneId',null)}
        : group == 'PROJECT' ? {'type':d.type,'title':d.title,'sourceId':d.sourceId,'currency':d.currency,'dueDate':d.dueDate,'agreedAmountMinor':d.agreedAmountMinor,'note':d.note}
        : group == 'MILESTONE' ? {'title':d.title,'dueDate':d.dueDate,'agreedAmountMinor':d.agreedAmountMinor}
        : group == 'CRYPTO' ? {'direction':d.direction,'amountMinor':d.amountMinor,'resultDate':d.resultDate,'note':d.note}
        : {'name':d.name,'archived':d.archived,'defaultValue':d.defaultValue};
    }
    function fMutation(uid, d) {
      let path = fTarget(uid, d);
      return (d.kind == 'CREATE' ? (!exists(path) && !exists(fState(uid, d.group, d.parentId, d.targetId)))
          : exists(path) && get(path).data.updatedAt == d.expectedUpdatedAt)
        && (d.group != 'RECEIPT' || d.parentId == getAfter(path).data.linkedPaymentId)
        && (d.kind == 'DELETE' ? (!existsAfter(path) && d.payload == {})
          : (existsAfter(path) && getAfter(path).data.updatedAt == request.time
            && (d.kind == 'CANCEL' ? (d.payload == {} && get(path).data.isCancelled == false && getAfter(path).data.isCancelled == true)
              : d.payload == fValues(d.group, getAfter(path).data))));
    }
    function fReceipt(uid, op, d) {
      let state = getAfter(fState(uid, d.group, d.parentId, d.targetId)).data;
      return fProof(d) && !existsAfter(/databases/$(database)/documents/users/$(uid)/syncFences/$(op))
        && state.operationId == op && state.updatedAt == request.time && state.deleted == (d.kind == 'DELETE')
        && fMutation(uid, d)
        && (d.group == 'CRYPTO' && d.kind != 'DELETE' ? getAfter(fTarget(uid, d)).data.lastOperationId == op
          : (d.group == 'MILESTONE' ? getAfter(fTarget(uid, d)).data.lastMilestoneOpId == op : true));
    }
    function fScope(d, group, parent, id) {
      return d.targetId == id && (group == 'INCOME'
        ? ((d.group == 'INCOME' && d.parentId == '') || (d.group == 'RECEIPT' && gId(d.parentId)))
        : d.group == group && d.parentId == parent);
    }
    function fGuard(uid, group, parent, id) {
      let path = fState(uid, group, parent, id);
      return !existsAfter(path) || (getAfter(path).data.updatedAt == request.time
        && !exists(/databases/$(database)/documents/users/$(uid)/syncOperations/$(getAfter(path).data.operationId))
        && fScope(getAfter(/databases/$(database)/documents/users/$(uid)/syncOperations/$(getAfter(path).data.operationId)).data, group, parent, id));
    }
    function fStateWrite(uid, group, parent, id, d) {
      let opPath = /databases/$(database)/documents/users/$(uid)/syncOperations/$(d.operationId);
      let fencePath = /databases/$(database)/documents/users/$(uid)/syncFences/$(d.operationId);
      let proof = existsAfter(opPath) ? getAfter(opPath).data : getAfter(fencePath).data;
      let target = fTarget(uid, proof);
      return d.keys().hasAll(['operationId','deleted','updatedAt']) && d.keys().hasOnly(['operationId','deleted','updatedAt'])
        && gId(d.operationId) && d.deleted is bool && d.updatedAt == request.time
        && fScope(proof, group, parent, id)
        && (existsAfter(opPath) ? (!exists(opPath) && d.deleted == (proof.kind == 'DELETE') && fMutation(uid, proof))
          : (!exists(fencePath) && !exists(fState(uid, group, parent, id))
            && (exists(target) ? (!d.deleted && existsAfter(target) && getAfter(target).data == get(target).data)
              : (d.deleted && !existsAfter(target)))));
    }
    match /users/{uid}/syncOperations/{op} {
      allow read: if gOwner(uid);
      allow create: if gOwner(uid) && gId(op) && fReceipt(uid, op, request.resource.data);
      allow update, delete: if false;
    }
    match /users/{uid}/syncFences/{op} {
      allow read: if gOwner(uid);
      allow create: if gOwner(uid) && gId(op) && fProof(request.resource.data)
        && !existsAfter(/databases/$(database)/documents/users/$(uid)/syncOperations/$(op))
        && existsAfter(fState(uid, request.resource.data.group, request.resource.data.parentId, request.resource.data.targetId))
        && (exists(fState(uid, request.resource.data.group, request.resource.data.parentId, request.resource.data.targetId))
          || getAfter(fState(uid, request.resource.data.group, request.resource.data.parentId, request.resource.data.targetId)).data.operationId == op);
      allow update, delete: if false;
    }
    match /users/{uid}/syncStates/{group}/records/{id} {
      allow read: if gOwner(uid);
      allow create, update: if gOwner(uid) && group in ['EXPENSE','INCOME','PROJECT','CRYPTO','CATEGORY','SOURCE']
        && fStateWrite(uid, group, '', id, request.resource.data);
      allow delete: if false;
    }
    match /users/{uid}/syncStates/MILESTONE/parents/{parent}/records/{id} {
      allow read: if gOwner(uid);
      allow create, update: if gOwner(uid) && fStateWrite(uid, 'MILESTONE', parent, id, request.resource.data);
      allow delete: if false;
    }

    // Recurring templates are obligations. Only an atomic confirmed occurrence creates actual spending.
    function rId(id) { return id is string && id.matches('^[A-Za-z0-9-]{1,128}$'); }
    function rTemplateValues(d) {
      return {'name':d.name,'categoryId':d.categoryId,'spendingType':d.spendingType,'paymentChannelId':d.paymentChannelId,
        'suggestedMinor':d.suggestedMinor,'firstDueDate':d.firstDueDate,'anchorDay':d.anchorDay,'cadence':d.cadence,'isCancelled':d.isCancelled};
    }
    function rClassifications(d) {
      return cId('category', d.categoryId)
        && d.spendingType in ['committed','discretionary'] && d.paymentChannelId in ['cash','primary_bank_card','secondary_bank_card','other'];
    }
    function rTemplate(d) {
      let fields = ['name','categoryId','spendingType','paymentChannelId','suggestedMinor','firstDueDate','anchorDay','cadence',
        'isCancelled','version','lastOperationId','createdAt','updatedAt'];
      return d.keys().hasAll(fields) && d.keys().hasOnly(fields)
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100 && d.name.matches('.*[^ \\t\\r\\n].*')
        && rClassifications(d) && d.suggestedMinor is int && d.suggestedMinor > 0
        && gDate(d.firstDueDate) && d.anchorDay is int && d.anchorDay >= 1 && d.anchorDay <= 31 && d.cadence == 'monthly'
        && d.isCancelled is bool && d.version is int && d.version >= 0 && rId(d.lastOperationId)
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    function rActual(d) {
      let fields = ['amountMinor','currency','categoryId','spendingType','paymentChannelId','expenseDate','note'];
      return d is map && d.keys().hasAll(fields) && d.keys().hasOnly(fields)
        && d.amountMinor is int && d.amountMinor > 0 && d.currency == 'LKR' && rClassifications(d)
        && gDate(d.expenseDate) && gDay(d.expenseDate) <= gToday() && d.note is string && d.note.size() <= 500;
    }
    function rExpenseValues(d) {
      return {'amountMinor':d.amountMinor,'currency':d.currency,'categoryId':d.categoryId,'spendingType':d.spendingType,
        'paymentChannelId':d.paymentChannelId,'expenseDate':d.expenseDate,'note':d.note};
    }
    function rOccurrenceValues(d) {
      return {'templateId':d.templateId,'month':d.month,'dueDate':d.dueDate,'templateVersion':d.templateVersion,
        'templateName':d.templateName,'expenseId':d.expenseId,'actual':d.actual};
    }
    function rLastDay(date) {
      let y = int(date[0:4]); let m = int(date[5:7]);
      return m == 2 ? (y % 400 == 0 || (y % 4 == 0 && y % 100 != 0) ? 29 : 28) : (m in [4,6,9,11] ? 30 : 31);
    }
    function rScheduled(t, d) {
      return d.month is string && d.month.matches('^[0-9]{4}-[0-9]{2}$') && gDate(d.month + '-01')
        && d.month >= t.firstDueDate[0:7] && gDate(d.dueDate) && d.dueDate[0:7] == d.month && gDay(d.dueDate) <= gToday()
        && (d.month == t.firstDueDate[0:7] ? d.dueDate == t.firstDueDate
          : int(d.dueDate[8:10]) == (t.anchorDay > rLastDay(d.dueDate) ? rLastDay(d.dueDate) : t.anchorDay));
    }
    function rOperation(uid, id) { return getAfter(/databases/$(database)/documents/users/$(uid)/recurringOperations/$(id)).data; }
    function rTemplateOperation(uid, id, d) {
      let op = rOperation(uid, d.lastOperationId);
      return !exists(/databases/$(database)/documents/users/$(uid)/recurringOperations/$(d.lastOperationId))
        && op.templateId == id && op.recordId == id && op.version == d.version && op.payload == rTemplateValues(d);
    }
    function rLinkedExpense(uid, id, d) {
      let path = /databases/$(database)/documents/users/$(uid)/recurringOccurrences/$(d.recurringOccurrenceId);
      let occurrence = getAfter(path).data;
      return id == 'rec_' + d.recurringOccurrenceId && !exists(path) && occurrence.expenseId == id
        && occurrence.createdAt == request.time && occurrence.actual == rExpenseValues(d);
    }
    match /users/{uid}/recurringTemplates/{templateId} {
      allow read: if gOwner(uid);
      allow create: if gOwner(uid) && rId(templateId) && rTemplate(request.resource.data)
        && cActive(uid, 'category', request.resource.data.categoryId)
        && !request.resource.data.isCancelled && request.resource.data.version == 0 && request.resource.data.createdAt == request.time
        && rTemplateOperation(uid, templateId, request.resource.data) && rOperation(uid, request.resource.data.lastOperationId).kind == 'CREATE';
      allow update: if gOwner(uid) && rTemplate(request.resource.data) && !resource.data.isCancelled
        && (request.resource.data.categoryId == resource.data.categoryId || cActive(uid, 'category', request.resource.data.categoryId))
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.firstDueDate == resource.data.firstDueDate
        && request.resource.data.version > resource.data.version && request.resource.data.version == resource.data.version + 1
        && rTemplateOperation(uid, templateId, request.resource.data)
        && ((rOperation(uid, request.resource.data.lastOperationId).kind == 'EDIT' && !request.resource.data.isCancelled)
          || (rOperation(uid, request.resource.data.lastOperationId).kind == 'CANCEL' && request.resource.data.isCancelled
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isCancelled','version','lastOperationId','updatedAt'])));
      allow delete: if false;
    }
    match /users/{uid}/recurringOccurrences/{occurrenceId} {
      function validOccurrence(d) {
        let templatePath = /databases/$(database)/documents/users/$(uid)/recurringTemplates/$(d.templateId);
        let template = get(templatePath).data;
        let expensePath = /databases/$(database)/documents/users/$(uid)/expenses/$(d.expenseId);
        let expense = getAfter(expensePath).data;
        let op = rOperation(uid, d.operationId);
        return rId(d.templateId) && rId(d.operationId) && occurrenceId == d.templateId + '_' + d.month && d.expenseId == 'rec_' + occurrenceId
          && exists(templatePath) && !template.isCancelled && getAfter(templatePath).data == template
          && d.templateVersion is int && d.templateVersion == template.version && d.templateName == template.name && rScheduled(template, d)
          && !exists(expensePath) && expense.recurringOccurrenceId == occurrenceId && expense.createdAt == request.time && expense.updatedAt == request.time
          && expense.note is string && d.actual == rExpenseValues(expense) && rActual(d.actual)
          && !exists(/databases/$(database)/documents/users/$(uid)/recurringOperations/$(d.operationId))
          && op.kind == 'CONFIRM' && op.recordId == occurrenceId && op.templateId == d.templateId
          && op.version == d.templateVersion && op.payload == rOccurrenceValues(d);
      }
      allow read: if gOwner(uid);
      allow create: if gOwner(uid)
        && request.resource.data.keys().hasAll(['templateId','month','dueDate','templateVersion','templateName','expenseId','actual','operationId','createdAt'])
        && request.resource.data.keys().hasOnly(['templateId','month','dueDate','templateVersion','templateName','expenseId','actual','operationId','createdAt'])
        && request.resource.data.createdAt == request.time && validOccurrence(request.resource.data);
      allow update, delete: if false;
    }
    match /users/{uid}/recurringOperations/{operationId} {
      function templateReceipt(d) {
        let path = /databases/$(database)/documents/users/$(uid)/recurringTemplates/$(d.templateId);
        let after = getAfter(path).data;
        return d.recordId == d.templateId && after.lastOperationId == operationId && after.version == d.version
          && after.updatedAt == request.time && d.payload == rTemplateValues(after)
          && (d.kind == 'CREATE' ? !exists(path)
            : exists(path) && after.version > get(path).data.version && after.version == get(path).data.version + 1);
      }
      function confirmationReceipt(d) {
        let path = /databases/$(database)/documents/users/$(uid)/recurringOccurrences/$(d.recordId);
        let after = getAfter(path).data;
        return !exists(path) && after.operationId == operationId && after.templateId == d.templateId
          && after.templateVersion == d.version && d.payload == rOccurrenceValues(after);
      }
      allow read: if gOwner(uid);
      allow create: if gOwner(uid) && rId(operationId)
        && request.resource.data.keys().hasAll(['kind','templateId','recordId','version','payload','createdAt'])
        && request.resource.data.keys().hasOnly(['kind','templateId','recordId','version','payload','createdAt'])
        && request.resource.data.kind in ['CREATE','EDIT','CANCEL','CONFIRM'] && rId(request.resource.data.templateId)
        && request.resource.data.recordId is string && request.resource.data.version is int && request.resource.data.version >= 0
        && request.resource.data.payload is map && request.resource.data.createdAt == request.time
        && (request.resource.data.kind == 'CONFIRM' ? confirmationReceipt(request.resource.data) : templateReceipt(request.resource.data));
      allow update, delete: if false;
    }

    function isValidExpense(data, isCreate) {
      let baseKeys = ['amountMinor', 'currency', 'categoryId', 'paymentChannelId', 'spendingType', 'expenseDate', 'updatedAt'];
      let requiredKeys = baseKeys.concat(['createdAt']);

      return data.keys().hasAll(requiredKeys)
        && data.keys().hasOnly(requiredKeys.concat(['note', 'recurringOccurrenceId']))
        && data.amountMinor is int && data.amountMinor > 0
        && data.currency == 'LKR'
        && cId('category', data.categoryId)
        && data.paymentChannelId in ['cash', 'primary_bank_card', 'secondary_bank_card', 'other']
        && data.spendingType in ['committed', 'discretionary']
        && gDate(data.expenseDate) && gDay(data.expenseDate) <= gToday()
        && (!('note' in data) || (data.note is string && data.note.size() <= 500))
        && (!('recurringOccurrenceId' in data) || (data.recurringOccurrenceId is string
            && gDate(data.expenseDate) && gDay(data.expenseDate) <= gToday()))
        && data.updatedAt == request.time
        && (isCreate ? data.createdAt == request.time : true);
    }

    function isValidAmountStr(str) {
      return str is string && str.size() <= 20 && str.matches('^[0-9]+(\\.[0-9]{1,2})?$') && !str.matches('^0+(\\.0+)?$');
    }

    function isValidRateStr(str) {
      return str is string && str.size() <= 20 && str.matches('^[0-9]+(\\.[0-9]{1,8})?$') && !str.matches('^0+(\\.0+)?$');
    }

    function isValidIncome(data, isCreate) {
      let baseKeys = ['sourceId', 'receiptDate', 'currency', 'originalAmountStr', 'lkrAmountMinor', 'conversionBasis', 'note', 'updatedAt'];
      let requiredKeys = isCreate ? baseKeys.concat(['createdAt']) : baseKeys;
      let allowedKeys = baseKeys.concat(['createdAt', 'conversionRateStr', 'linkedPaymentId', 'linkedMilestoneId', 'originalAmountMinor']);

      return data.keys().hasAll(requiredKeys)
        && data.keys().hasOnly(allowedKeys)
        && cId('source', data.sourceId)
        && data.currency in ['LKR', 'USD']
        && data.conversionBasis in ['native_lkr', 'confirmed_rate', 'actual_credit']
        && isValidAmountStr(data.originalAmountStr)
        && data.lkrAmountMinor is int && data.lkrAmountMinor > 0
        && (!('originalAmountMinor' in data.keys()) || (data.originalAmountMinor is int && data.originalAmountMinor > 0))
        && gDate(data.receiptDate) && gDay(data.receiptDate) <= gToday()
        && data.note is string && data.note.size() <= 500
        && data.updatedAt == request.time
        && (isCreate ? data.createdAt == request.time : true)
        // Schema Consistency rules:
        && (data.currency == 'LKR' ? (data.conversionBasis == 'native_lkr' && 'conversionRateStr' in data && data.conversionRateStr == '1') : true)
        && (data.currency == 'USD' ? (data.conversionBasis in ['confirmed_rate', 'actual_credit']) : true)
        && (data.conversionBasis == 'confirmed_rate' ? ('conversionRateStr' in data && isValidRateStr(data.conversionRateStr)) : true)
        && (data.conversionBasis == 'actual_credit' ? (!('conversionRateStr' in data) || data.conversionRateStr == null) : true);
    }

    function isValidPaymentAmounts(data) {
      return data.agreedAmountMinor is int
        && data.agreedAmountMinor > 0
        && data.agreedAmountMinor <= 100000000000
        && data.allocatedAmountMinor is int
        && data.allocatedAmountMinor >= 0
        && data.directReceivedAmountMinor is int
        && data.directReceivedAmountMinor >= 0
        && data.milestoneReceivedAmountMinor is int
        && data.milestoneReceivedAmountMinor >= 0;
    }

    function isValidMilestoneAmounts(data) {
      return data.agreedAmountMinor is int
        && data.agreedAmountMinor > 0
        && data.agreedAmountMinor <= 100000000000
        && data.receivedAmountMinor is int
        && data.receivedAmountMinor >= 0;
    }

    // A matching pointer alone is not proof of a payment. Require existing
    // records and the corresponding counter deltas in this atomic operation.
    function isValidMilestoneReceipt(userId, receiptId, data, parentBefore, parentAfter) {
      let milestonePath = /databases/$(database)/documents/users/$(userId)/expectedPayments/$(data.linkedPaymentId)/milestones/$(data.linkedMilestoneId);
      let before = get(milestonePath).data;
      let after = getAfter(milestonePath).data;
      return exists(milestonePath)
        && parentBefore.type == 'project'
        && before.isCancelled == false && after.isCancelled == false
        && after.lastReceiptId == receiptId
        && after.receivedAmountMinor - before.receivedAmountMinor == data.originalAmountMinor
        && parentAfter.milestoneReceivedAmountMinor - parentBefore.milestoneReceivedAmountMinor == data.originalAmountMinor;
    }

    function isValidLinkedReceipt(userId, receiptId, data) {
      let parentPath = /databases/$(database)/documents/users/$(userId)/expectedPayments/$(data.linkedPaymentId);
      let before = get(parentPath).data;
      let after = getAfter(parentPath).data;
      return exists(parentPath)
        && before.isCancelled == false && after.isCancelled == false
        && data.originalAmountMinor is int && data.originalAmountMinor > 0
        && data.currency == before.currency && data.sourceId == before.sourceId
        && after.lastReceiptId == receiptId
        && ('linkedMilestoneId' in data && data.linkedMilestoneId != null
            ? (data.linkedMilestoneId is string && data.linkedMilestoneId.size() > 0
               && isValidMilestoneReceipt(userId, receiptId, data, before, after))
            : after.directReceivedAmountMinor - before.directReceivedAmountMinor == data.originalAmountMinor);
    }

    // Regex checks shape only. Calendar lengths/leap years and the Colombo cutoff
    // are checked separately; resultDate remains the authoritative reporting date.
    function validCryptoCalendar(date) {
      let year = int(date[0:4]);
      let month = int(date[5:7]);
      let day = int(date[8:10]);
      let leap = year % 400 == 0 || (year % 4 == 0 && year % 100 != 0);
      let maxDay = month == 2 ? (leap ? 29 : 28) : (month in [4, 6, 9, 11] ? 30 : 31);
      let today = request.time + duration.value(330, 'm');
      return year >= 1 && month >= 1 && month <= 12 && day >= 1 && day <= maxDay
        && (year < today.year() || (year == today.year()
          && (month < today.month() || (month == today.month() && day <= today.day()))));
    }

    function validCrypto(data) {
      let fields = ['direction', 'amountMinor', 'resultDate', 'note', 'lastOperationId', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.direction in ['gain', 'loss']
        && data.amountMinor is int && data.amountMinor > 0
        && data.resultDate is string && data.resultDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && validCryptoCalendar(data.resultDate)
        && data.note is string && data.note.size() <= 500
        && data.lastOperationId is string && data.lastOperationId.size() > 0 && data.lastOperationId.size() <= 128
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }

    match /users/{userId}/cryptoResults/{resultId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow delete: if gOwner(userId) && fGuard(userId, 'CRYPTO', '', resultId);
      allow create: if request.auth != null && request.auth.uid == userId
                    && fGuard(userId, 'CRYPTO', '', resultId)
        && validCrypto(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && request.auth.uid == userId
                    && fGuard(userId, 'CRYPTO', '', resultId)
        && validCrypto(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /users/{userId}/expenses/{expenseId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow delete: if gOwner(userId) && fGuard(userId, 'EXPENSE', '', expenseId);
      allow create: if request.auth != null && request.auth.uid == userId
                    && fGuard(userId, 'EXPENSE', '', expenseId)
                    && isValidExpense(request.resource.data, true) && cActive(userId, 'category', request.resource.data.categoryId)
                    && ('recurringOccurrenceId' in request.resource.data
                        ? rLinkedExpense(userId, expenseId, request.resource.data)
                        : !expenseId.matches('^rec_.*'));

      allow update: if request.auth != null && request.auth.uid == userId
                    && fGuard(userId, 'EXPENSE', '', expenseId)
                    && isValidExpense(request.resource.data, false) && (request.resource.data.categoryId == resource.data.categoryId || cActive(userId, 'category', request.resource.data.categoryId))
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amountMinor', 'currency', 'categoryId', 'paymentChannelId', 'spendingType', 'expenseDate', 'note', 'updatedAt'])
                    && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /users/{userId}/incomeReceipts/{receiptId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow delete: if request.auth != null && request.auth.uid == userId
                    && fGuard(userId, 'INCOME', '', receiptId)
                    && (!('linkedPaymentId' in resource.data) || resource.data.linkedPaymentId == null);

      allow create: if request.auth != null && request.auth.uid == userId
                    && fGuard(userId, 'INCOME', '', receiptId)
                    && isValidIncome(request.resource.data, true)
                    && (cActive(userId, 'source', request.resource.data.sourceId) || request.resource.data.get('linkedPaymentId', null) is string)
                    && (
                      (!('linkedPaymentId' in request.resource.data) || request.resource.data.linkedPaymentId == null)
                      ? (!('linkedMilestoneId' in request.resource.data) || request.resource.data.linkedMilestoneId == null)
                      : (request.resource.data.linkedPaymentId is string && request.resource.data.linkedPaymentId.size() > 0
                         && isValidLinkedReceipt(userId, receiptId, request.resource.data))
                    );

      allow update: if request.auth != null && request.auth.uid == userId
                    && fGuard(userId, 'INCOME', '', receiptId)
                    && isValidIncome(request.resource.data, false) && (request.resource.data.sourceId == resource.data.sourceId || cActive(userId, 'source', request.resource.data.sourceId))
                    && (!('linkedPaymentId' in resource.data) || resource.data.linkedPaymentId == null)
                    && (!('linkedPaymentId' in request.resource.data) || request.resource.data.linkedPaymentId == null)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sourceId', 'receiptDate', 'currency', 'originalAmountStr', 'lkrAmountMinor', 'conversionBasis', 'conversionRateStr', 'originalAmountMinor', 'note', 'updatedAt'])
                    && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /users/{userId}/expectedPayments/{paymentId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null && request.auth.uid == userId
                    && fGuard(userId, 'PROJECT', '', paymentId)
                    && request.resource.data.keys().hasAll(['type', 'title', 'sourceId', 'currency', 'dueDate', 'agreedAmountMinor', 'allocatedAmountMinor', 'directReceivedAmountMinor', 'milestoneReceivedAmountMinor', 'isCancelled', 'note', 'createdAt', 'updatedAt'])
                    && request.resource.data.keys().hasOnly(['type', 'title', 'sourceId', 'currency', 'dueDate', 'agreedAmountMinor', 'allocatedAmountMinor', 'directReceivedAmountMinor', 'milestoneReceivedAmountMinor', 'isCancelled', 'note', 'createdAt', 'updatedAt'])
                    && cActive(userId, 'source', request.resource.data.sourceId)
                    && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
                    && gDate(request.resource.data.dueDate) && request.resource.data.note is string && request.resource.data.note.size() <= 500
                    && request.resource.data.currency in ['LKR','USD']
                    && request.resource.data.type in ['standalone', 'project']
                    && isValidPaymentAmounts(request.resource.data)
                    && request.resource.data.allocatedAmountMinor == 0
                    && request.resource.data.directReceivedAmountMinor == 0
                    && request.resource.data.milestoneReceivedAmountMinor == 0
                    && request.resource.data.isCancelled == false
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;

      allow update: if request.auth != null && request.auth.uid == userId
                    && (fGuard(userId, 'PROJECT', '', paymentId) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['allocatedAmountMinor','directReceivedAmountMinor','milestoneReceivedAmountMinor','lastReceiptId','lastMilestoneId','lastMilestoneOpId','updatedAt']))
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.type == resource.data.type
                    && request.resource.data.currency == resource.data.currency
                    && request.resource.data.sourceId == resource.data.sourceId
                    && isValidPaymentAmounts(request.resource.data)
                    && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
                    && gDate(request.resource.data.dueDate) && request.resource.data.note is string && request.resource.data.note.size() <= 500
                    && (
                      // Branch 1: Direct Payment
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['directReceivedAmountMinor', 'lastReceiptId', 'updatedAt'])
                       && resource.data.isCancelled == false
                       && request.resource.data.directReceivedAmountMinor > resource.data.directReceivedAmountMinor
                       && request.resource.data.directReceivedAmountMinor <= request.resource.data.agreedAmountMinor - request.resource.data.allocatedAmountMinor
                       && !exists(/databases/$(database)/documents/users/$(userId)/incomeReceipts/$(request.resource.data.lastReceiptId))
                       && getAfter(/databases/$(database)/documents/users/$(userId)/incomeReceipts/$(request.resource.data.lastReceiptId)).data.originalAmountMinor == request.resource.data.directReceivedAmountMinor - resource.data.directReceivedAmountMinor
                       && getAfter(/databases/$(database)/documents/users/$(userId)/incomeReceipts/$(request.resource.data.lastReceiptId)).data.linkedPaymentId == paymentId
                       && (!('linkedMilestoneId' in getAfter(/databases/$(database)/documents/users/$(userId)/incomeReceipts/$(request.resource.data.lastReceiptId)).data) || getAfter(/databases/$(database)/documents/users/$(userId)/incomeReceipts/$(request.resource.data.lastReceiptId)).data.linkedMilestoneId == null)
                       && getAfter(/databases/$(database)/documents/users/$(userId)/incomeReceipts/$(request.resource.data.lastReceiptId)).data.currency == resource.data.currency
                       && getAfter(/databases/$(database)/documents/users/$(userId)/incomeReceipts/$(request.resource.data.lastReceiptId)).data.sourceId == resource.data.sourceId
                      )
                      ||
                      // Branch 2: Milestone Payment
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['milestoneReceivedAmountMinor', 'lastReceiptId', 'updatedAt'])
                       && resource.data.isCancelled == false
                       && request.resource.data.milestoneReceivedAmountMinor > resource.data.milestoneReceivedAmountMinor
                       && !exists(/databases/$(database)/documents/users/$(userId)/incomeReceipts/$(request.resource.data.lastReceiptId))
                       && getAfter(/databases/$(database)/documents/users/$(userId)/incomeReceipts/$(request.resource.data.lastReceiptId)).data.originalAmountMinor == request.resource.data.milestoneReceivedAmountMinor - resource.data.milestoneReceivedAmountMinor
                       && getAfter(/databases/$(database)/documents/users/$(userId)/incomeReceipts/$(request.resource.data.lastReceiptId)).data.linkedPaymentId == paymentId
                       && getAfter(/databases/$(database)/documents/users/$(userId)/incomeReceipts/$(request.resource.data.lastReceiptId)).data.currency == resource.data.currency
                       && getAfter(/databases/$(database)/documents/users/$(userId)/incomeReceipts/$(request.resource.data.lastReceiptId)).data.sourceId == resource.data.sourceId
                       && getAfter(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)/milestones/$(getAfter(/databases/$(database)/documents/users/$(userId)/incomeReceipts/$(request.resource.data.lastReceiptId)).data.linkedMilestoneId)).data.lastReceiptId == request.resource.data.lastReceiptId
                      )
                      ||
                      // Branch 3: Milestone Allocation change
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['allocatedAmountMinor', 'lastMilestoneId', 'lastMilestoneOpId', 'updatedAt'])
                       && resource.data.type == 'project'
                       && (resource.data.isCancelled == false ||
                           (request.resource.data.allocatedAmountMinor <= resource.data.allocatedAmountMinor
                            && get(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)/milestones/$(request.resource.data.lastMilestoneId)).data.isCancelled == false
                            && getAfter(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)/milestones/$(request.resource.data.lastMilestoneId)).data.isCancelled == true))
                       && request.resource.data.allocatedAmountMinor <= request.resource.data.agreedAmountMinor - request.resource.data.directReceivedAmountMinor
                       && (!('lastMilestoneOpId' in resource.data) || request.resource.data.lastMilestoneOpId != resource.data.lastMilestoneOpId)
                       && getAfter(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)/milestones/$(request.resource.data.lastMilestoneId)).data.lastMilestoneOpId == request.resource.data.lastMilestoneOpId
                       && request.resource.data.allocatedAmountMinor - resource.data.allocatedAmountMinor ==
                          (getAfter(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)/milestones/$(request.resource.data.lastMilestoneId)).data.isCancelled ? getAfter(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)/milestones/$(request.resource.data.lastMilestoneId)).data.receivedAmountMinor : getAfter(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)/milestones/$(request.resource.data.lastMilestoneId)).data.agreedAmountMinor) -
                          (exists(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)/milestones/$(request.resource.data.lastMilestoneId)) ?
                             (get(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)/milestones/$(request.resource.data.lastMilestoneId)).data.isCancelled ? get(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)/milestones/$(request.resource.data.lastMilestoneId)).data.receivedAmountMinor : get(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)/milestones/$(request.resource.data.lastMilestoneId)).data.agreedAmountMinor)
                           : 0)
                      )
                      ||
                      // Branch 4: Cancellation
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isCancelled', 'updatedAt'])
                       && resource.data.isCancelled == false
                       && request.resource.data.isCancelled == true
                      )
                      ||
                      // Branch 5: Metadata edit (including agreedAmountMinor)
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'dueDate', 'agreedAmountMinor', 'note', 'updatedAt'])
                       && resource.data.isCancelled == false
                       && request.resource.data.agreedAmountMinor >= request.resource.data.allocatedAmountMinor + request.resource.data.directReceivedAmountMinor
                      )
                    );
    }

    match /users/{userId}/expectedPayments/{paymentId}/milestones/{milestoneId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null && request.auth.uid == userId
                    && fGuard(userId, 'MILESTONE', paymentId, milestoneId)
                    && exists(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId))
                    && get(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)).data.isCancelled == false
                    && getAfter(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)).data.isCancelled == false
                    && getAfter(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)).data.type == 'project'
                    && request.resource.data.keys().hasAll(['title', 'dueDate', 'agreedAmountMinor', 'receivedAmountMinor', 'isCancelled', 'lastMilestoneOpId', 'createdAt', 'updatedAt'])
                    && request.resource.data.keys().hasOnly(['title', 'dueDate', 'agreedAmountMinor', 'receivedAmountMinor', 'isCancelled', 'lastMilestoneOpId', 'createdAt', 'updatedAt'])
                    && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
                    && gDate(request.resource.data.dueDate)
                    && isValidMilestoneAmounts(request.resource.data)
                    && request.resource.data.receivedAmountMinor == 0
                    && request.resource.data.isCancelled == false
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && getAfter(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)).data.allocatedAmountMinor -
                       get(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)).data.allocatedAmountMinor == request.resource.data.agreedAmountMinor
                    && getAfter(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)).data.lastMilestoneOpId == request.resource.data.lastMilestoneOpId
                    && getAfter(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)).data.lastMilestoneId == milestoneId;

      allow update: if request.auth != null && request.auth.uid == userId
                    && (fGuard(userId, 'MILESTONE', paymentId, milestoneId) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receivedAmountMinor','lastReceiptId','updatedAt']))
                    && exists(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId))
                    && getAfter(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)).data.type == 'project'
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
                    && gDate(request.resource.data.dueDate)
                    && isValidMilestoneAmounts(request.resource.data)
                    && (
                      // Branch 1: Payment
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receivedAmountMinor', 'lastReceiptId', 'updatedAt'])
                       && resource.data.isCancelled == false
                       && request.resource.data.receivedAmountMinor > resource.data.receivedAmountMinor
                       && request.resource.data.receivedAmountMinor <= request.resource.data.agreedAmountMinor
                       && !exists(/databases/$(database)/documents/users/$(userId)/incomeReceipts/$(request.resource.data.lastReceiptId))
                       && getAfter(/databases/$(database)/documents/users/$(userId)/incomeReceipts/$(request.resource.data.lastReceiptId)).data.originalAmountMinor == request.resource.data.receivedAmountMinor - resource.data.receivedAmountMinor
                       && getAfter(/databases/$(database)/documents/users/$(userId)/incomeReceipts/$(request.resource.data.lastReceiptId)).data.linkedPaymentId == paymentId
                       && getAfter(/databases/$(database)/documents/users/$(userId)/incomeReceipts/$(request.resource.data.lastReceiptId)).data.linkedMilestoneId == milestoneId
                       && getAfter(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)).data.lastReceiptId == request.resource.data.lastReceiptId
                       && getAfter(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)).data.type == 'project'
                       && getAfter(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)).data.isCancelled == false
                      )
                      ||
                      // Branch 2: Edit
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'dueDate', 'agreedAmountMinor', 'lastMilestoneOpId', 'updatedAt'])
                       && get(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)).data.isCancelled == false
                       && getAfter(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)).data.isCancelled == false
                       && request.resource.data.agreedAmountMinor >= request.resource.data.receivedAmountMinor
                       && request.resource.data.isCancelled == false
                       && (!('lastMilestoneOpId' in resource.data) || request.resource.data.lastMilestoneOpId != resource.data.lastMilestoneOpId)
                       && getAfter(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)).data.lastMilestoneOpId == request.resource.data.lastMilestoneOpId
                       && getAfter(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)).data.lastMilestoneId == milestoneId
                      )
                      ||
                      // Branch 3: Cancellation
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isCancelled', 'lastMilestoneOpId', 'updatedAt'])
                       && resource.data.isCancelled == false
                       && request.resource.data.isCancelled == true
                       && (!('lastMilestoneOpId' in resource.data) || request.resource.data.lastMilestoneOpId != resource.data.lastMilestoneOpId)
                       && getAfter(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)).data.lastMilestoneOpId == request.resource.data.lastMilestoneOpId
                       && getAfter(/databases/$(database)/documents/users/$(userId)/expectedPayments/$(paymentId)).data.lastMilestoneId == milestoneId
                      )
                    );
    }
  }
}
