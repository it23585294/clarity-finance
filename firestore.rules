rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidExpense(data, isCreate) {
      let baseKeys = ['amountMinor', 'currency', 'categoryId', 'paymentChannelId', 'spendingType', 'expenseDate', 'note', 'updatedAt'];
      let requiredKeys = baseKeys.concat(['createdAt']);

      return data.keys().hasAll(requiredKeys)
        && data.keys().hasOnly(requiredKeys)
        && data.amountMinor is int && data.amountMinor > 0
        && data.currency == 'LKR'
        && data.categoryId in ['food_dining', 'transport', 'housing', 'utilities', 'shopping', 'health', 'entertainment', 'education', 'other']
        && data.paymentChannelId in ['cash', 'primary_bank_card', 'secondary_bank_card', 'other']
        && data.spendingType in ['committed', 'discretionary']
        && data.expenseDate is string && data.expenseDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.note is string && data.note.size() <= 500
        && data.updatedAt == request.time
        && (isCreate ? data.createdAt == request.time : true);
    }

    function isValidAmountStr(str) {
      return str is string && str.size() <= 20 && str.matches('^[0-9]+(\\.[0-9]{1,2})?$') && !str.matches('^0+(\\.0+)?$');
    }

    function isValidRateStr(str) {
      return str is string && str.size() <= 20 && str.matches('^[0-9]+(\\.[0-9]{1,8})?$') && !str.matches('^0+(\\.0+)?$');
    }

    function isValidIncome(data, isCreate) {
      let baseKeys = ['sourceId', 'receiptDate', 'currency', 'originalAmountStr', 'lkrAmountMinor', 'conversionBasis', 'note', 'updatedAt'];
      let requiredKeys = baseKeys.concat(['createdAt']);
      let allowedKeys = requiredKeys.concat(['conversionRateStr']);

      return data.keys().hasAll(requiredKeys)
        && data.keys().hasOnly(allowedKeys)
        && data.sourceId in ['salary', 'freelance', 'adsense']
        && data.currency in ['LKR', 'USD']
        && data.conversionBasis in ['native_lkr', 'confirmed_rate', 'actual_credit']
        && isValidAmountStr(data.originalAmountStr)
        && data.lkrAmountMinor is int && data.lkrAmountMinor > 0
        && data.receiptDate is string && data.receiptDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.note is string && data.note.size() <= 500
        && data.updatedAt == request.time
        && (isCreate ? data.createdAt == request.time : true)
        // Schema Consistency rules:
        && (data.currency == 'LKR' ? (data.conversionBasis == 'native_lkr' && 'conversionRateStr' in data && data.conversionRateStr == '1') : true)
        && (data.currency == 'USD' ? (data.conversionBasis in ['confirmed_rate', 'actual_credit']) : true)
        && (data.conversionBasis == 'confirmed_rate' ? ('conversionRateStr' in data && isValidRateStr(data.conversionRateStr)) : true)
        && (data.conversionBasis == 'actual_credit' ? (!('conversionRateStr' in data) || data.conversionRateStr == null) : true);
    }

    match /users/{userId}/expenses/{expenseId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null && request.auth.uid == userId
                    && isValidExpense(request.resource.data, true);

      allow update: if request.auth != null && request.auth.uid == userId
                    && isValidExpense(request.resource.data, false)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amountMinor', 'currency', 'categoryId', 'paymentChannelId', 'spendingType', 'expenseDate', 'note', 'updatedAt'])
                    && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /users/{userId}/incomeReceipts/{receiptId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null && request.auth.uid == userId
                    && isValidIncome(request.resource.data, true);

      allow update: if request.auth != null && request.auth.uid == userId
                    && isValidIncome(request.resource.data, false)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sourceId', 'receiptDate', 'currency', 'originalAmountStr', 'lkrAmountMinor', 'conversionBasis', 'conversionRateStr', 'note', 'updatedAt'])
                    && request.resource.data.createdAt == resource.data.createdAt;
    }
  }
}
